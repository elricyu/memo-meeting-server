# Cloud API keys must only exist on the server. Keep .env untracked.
DASHSCOPE_API_KEY=
ASR_MODEL=fun-asr-realtime
# For workspace endpoints, replace with your actual workspace and region.
ASR_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
ASR_VOCABULARY_ID=
LLM_API_KEY=
LLM_MODEL=qwen-plus
LLM_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
BIND_ADDRESS=127.0.0.1
PORT=8090
DATA_DIR=./data
ALLOWED_ORIGINS=http://localhost:8090,http://127.0.0.1:8090,http://localhost:5173,http://127.0.0.1:5173
MAX_RECORDING_SECONDS=14400

# Set true when served through HTTPS in production.
SESSION_COOKIE_SECURE=false
